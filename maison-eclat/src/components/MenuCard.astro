---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image: ImageMetadata; alt: string; dish: string; description: string; price: string; tag?: string }
const { image, alt, dish, description, price, tag } = Astro.props;
---
<article class="group flex flex-col bg-background border border-border rounded-sm overflow-hidden">
  <div class="h-[220px] overflow-hidden">
    <Picture src={image} alt={alt} widths={[400, 640, 900]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" formats={['avif', 'webp']}
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" />
  </div>
  <div class="p-5 flex flex-col gap-2">
    {tag && <span class="eyebrow">{tag}</span>}
    <div class="flex justify-between items-baseline gap-3">
      <h3 class="font-headings text-lg text-foreground leading-snug">{dish}</h3>
      <span class="font-body text-sm font-bold text-primary whitespace-nowrap">€{price}</span>
    </div>
    <p class="font-body text-sm text-muted-foreground leading-relaxed">{description}</p>
  </div>
</article>
