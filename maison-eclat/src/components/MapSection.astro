---
import { MapPin, ArrowUpRight } from '@lucide/astro';
import { site } from '../data/site';
const full = `${site.address.street}, ${site.address.postcode} ${site.address.city}`;
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.name}, ${full}`)}`;
---
<div id="contact" class="flex flex-col overflow-hidden rounded-sm border border-border bg-background scroll-mt-24">
  <a href={directions} target="_blank" rel="noopener" class="relative block w-full h-[260px] group" aria-label={`Open ${site.name} in Google Maps`}>
    <!-- Illustrated neighbourhood map (inline SVG, no third-party embed) -->
    <svg class="absolute inset-0 w-full h-full" viewBox="0 0 400 260" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#b9a184" stroke-width="1" opacity=".55" />
        </pattern>
        <radialGradient id="vignette" cx="50%" cy="50%" r="75%">
          <stop offset="60%" stop-color="#f3eadc" stop-opacity="0" />
          <stop offset="100%" stop-color="#c9b293" stop-opacity=".55" />
        </radialGradient>
      </defs>
      <rect width="400" height="260" fill="#f3eadc" />
      <!-- blocks -->
      <g fill="#ebdfcc" stroke="#d6c5ac" stroke-width=".8">
        <rect x="14" y="16" width="70" height="48" rx="2" /><rect x="100" y="12" width="60" height="44" rx="2" />
        <rect x="236" y="20" width="58" height="52" rx="2" /><rect x="310" y="14" width="78" height="58" rx="2" />
        <rect x="18" y="168" width="64" height="60" rx="2" /><rect x="236" y="150" width="62" height="40" rx="2" />
        <rect x="312" y="150" width="74" height="44" rx="2" /><rect x="236" y="206" width="150" height="44" rx="2" />
        <rect x="102" y="196" width="66" height="52" rx="2" />
      </g>
      <!-- park -->
      <rect x="310" y="88" width="78" height="44" rx="3" fill="url(#hatch)" stroke="#b9a184" stroke-width=".8" />
      <!-- canal / basin (Port de l'Arsenal) -->
      <path d="M150 260 C 150 220, 168 196, 176 160 L 186 160 C 178 198, 162 222, 162 260 Z" fill="#dccbb3" stroke="#a88b6c" stroke-width=".9" />
      <!-- streets -->
      <g stroke="#5c3d26" fill="none" stroke-linecap="round">
        <path d="M0 132 L 400 128" stroke-width="5" opacity=".9" />      <!-- Faubourg St-Antoine (main) -->
        <path d="M200 0 L 182 260" stroke-width="2.2" opacity=".55" />
        <path d="M0 84 L 182 122" stroke-width="2.2" opacity=".55" />
        <path d="M0 200 L 180 140" stroke-width="2.2" opacity=".55" />
        <path d="M120 0 L 182 120" stroke-width="1.6" opacity=".45" />
        <path d="M300 0 L 302 260" stroke-width="1.4" opacity=".4" />
        <path d="M218 0 L 230 260" stroke-width="1.2" opacity=".35" />
        <path d="M230 82 L 400 80" stroke-width="1.2" opacity=".35" />
        <path d="M200 196 L 400 198" stroke-width="1.2" opacity=".35" />
        <path d="M90 0 L 92 120" stroke-width="1" opacity=".3" />
        <path d="M60 140 L 40 260" stroke-width="1" opacity=".3" />
      </g>
      <!-- Place de la Bastille roundabout -->
      <circle cx="186" cy="130" r="17" fill="#f3eadc" stroke="#5c3d26" stroke-width="2.4" opacity=".85" />
      <circle cx="186" cy="130" r="3.2" fill="#9b4c1e" />
      <!-- destination marker dot -->
      <circle cx="292" cy="129" r="6" fill="#9b4c1e" opacity=".25" /><circle cx="292" cy="129" r="3" fill="#9b4c1e" />
      <rect width="400" height="260" fill="url(#vignette)" />
    </svg>
    <span class="absolute inset-0 flex items-center justify-center">
      <span class="bg-primary text-primary-foreground rounded-sm px-4 py-2 flex items-center gap-2 font-body text-sm font-bold shadow-[0_6px_20px_-6px_rgba(30,21,16,.5)] transition-transform group-hover:-translate-y-0.5">
        <MapPin size={15} /> {site.address.short}
      </span>
    </span>
  </a>
  <div class="bg-secondary px-6 py-5 flex flex-wrap items-center justify-between gap-3">
    <address class="not-italic flex flex-col gap-1">
      <span class="font-body text-sm font-bold text-foreground">{site.name}</span>
      <span class="font-body text-xs text-muted-foreground">{full}</span>
    </address>
    <a href={directions} target="_blank" rel="noopener" class="font-body text-xs text-primary font-bold flex items-center gap-1.5 border-b border-primary pb-0.5 hover:text-primary-hover">
      Get Directions <ArrowUpRight size={12} />
    </a>
  </div>
</div>
