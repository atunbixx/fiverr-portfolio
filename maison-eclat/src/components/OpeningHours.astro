---
import { hours } from '../data/site';
---
<div class="bg-secondary rounded-sm p-6 sm:p-8 flex flex-col gap-5 lg:bg-transparent lg:px-0 lg:pt-2">
  <h2 class="font-headings text-2xl text-foreground mb-1">Opening Hours</h2>
  <dl class="flex flex-col gap-1">
    {hours.map((h) => (
      <div class={`flex flex-wrap justify-between items-baseline gap-x-4 gap-y-1 py-2.5 border-b border-border ${h.closed ? 'opacity-50' : ''}`}>
        <dt class="font-body text-sm text-secondary-foreground">{h.day}</dt>
        <dd class={`font-body text-sm font-bold ${h.closed ? 'text-muted-foreground' : 'text-foreground'}`}>{h.time}</dd>
      </div>
    ))}
  </dl>
  <p class="font-body text-xs text-muted-foreground mt-1">Kitchen closes 30 minutes before closing time.</p>
</div>
