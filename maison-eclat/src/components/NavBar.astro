---
import { Menu, X } from '@lucide/astro';
import { site, nav } from '../data/site';
---
<header class="sticky top-0 z-40 bg-background/95 backdrop-blur border-b border-border">
  <nav class="mx-auto flex items-center justify-between px-5 sm:px-8 lg:px-16 py-4 lg:py-6" aria-label="Main">
    <a href="#top" class="font-headings text-xl font-bold text-foreground tracking-tight">{site.name}</a>
    <ul class="hidden md:flex items-center gap-10">
      {nav.map((l) => (
        <li><a href={l.href} class="font-body text-sm tracking-wide text-muted-foreground hover:text-primary transition-colors">{l.label}</a></li>
      ))}
    </ul>
    <div class="flex items-center gap-3">
      <a href="#reservations" class="btn-primary px-5 sm:px-6 py-2.5">Book a Table</a>
      <button id="nav-toggle" type="button" class="md:hidden p-2 -mr-2 text-foreground" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <Menu size={22} class="icon-open" />
        <X size={22} class="icon-close hidden" />
      </button>
    </div>
  </nav>
  <div id="mobile-nav" class="md:hidden hidden border-t border-border bg-background">
    <ul class="flex flex-col px-5 sm:px-8 py-3">
      {nav.map((l) => (
        <li><a href={l.href} class="block py-3 font-headings text-lg text-foreground border-b border-border last:border-0">{l.label}</a></li>
      ))}
    </ul>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle')!;
  const panel = document.getElementById('mobile-nav')!;
  const set = (open: boolean) => {
    panel.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    btn.querySelector('.icon-open')!.classList.toggle('hidden', open);
    btn.querySelector('.icon-close')!.classList.toggle('hidden', !open);
  };
  btn.addEventListener('click', () => set(panel.classList.contains('hidden')));
  panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
</script>
