---
import Base from '../layouts/Base.astro';
import NavBar from '../components/NavBar.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import ServiceMenu from '../components/ServiceMenu.astro';
import Studio from '../components/Studio.astro';
import Stylists from '../components/Stylists.astro';
import BookingWidget from '../components/BookingWidget.astro';
import Lookbook from '../components/Lookbook.astro';
import Testimonials from '../components/Testimonials.astro';
import GiftBanner from '../components/GiftBanner.astro';
import Visit from '../components/Visit.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<Base>
  <NavBar />
  <main id="main">
    <Hero />
    <Marquee />
    <ServiceMenu />
    <Studio />
    <Stylists />
    <BookingWidget />
    <Lookbook />
    <Testimonials />
    <GiftBanner />
    <Visit />
  </main>
  <SiteFooter />
</Base>
