---
import { menu, site } from '../data/site';
const fmtDur = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} hr${m % 60 ? ` ${m % 60} min` : ''}` : `${m} min`);
---
<section id="services" class="px-5 sm:px-8 lg:px-16 py-20 lg:py-28">
  <div class="grid lg:grid-cols-12 gap-8 mb-12 reveal">
    <div class="lg:col-span-6">
      <p class="eyebrow mb-4">The Menu</p>
      <h2 class="h2">Services &amp; <em class="italic text-rose-deep">pricing</em></h2>
    </div>
    <p class="lg:col-span-5 lg:col-start-8 self-end text-muted-foreground leading-relaxed">
      Transparent starting prices. Your stylist confirms the final quote at your complimentary consultation — length and density can change the time needed.
    </p>
  </div>

  <div class="reveal">
    <div role="tablist" aria-label="Service categories" class="flex gap-2 overflow-x-auto pb-2 mb-8 -mx-5 px-5 sm:mx-0 sm:px-0 [scrollbar-width:none]">
      {menu.map((c, i) => (
        <button role="tab" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
          class="shrink-0 rounded-full border px-5 py-2.5 text-sm font-semibold transition-colors border-border text-foreground/75 hover:border-ink/40 aria-selected:bg-ink aria-selected:text-on-ink aria-selected:border-ink">
          {c.label}
        </button>
      ))}
    </div>
    {menu.map((c, i) => (
      <div role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} class:list={['grid md:grid-cols-2 gap-x-12', { hidden: i !== 0 }]}>
        {c.services.map((s) => (
          <article class="group flex items-start justify-between gap-6 py-6 border-b border-border">
            <div>
              <h3 class="display-sm text-2xl text-foreground mb-1.5">{s.name}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed mb-3">{s.description}</p>
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-foreground/60">{fmtDur(s.duration)}</p>
            </div>
            <div class="text-right shrink-0 flex flex-col items-end gap-3">
              <p class="display-sm text-2xl text-foreground whitespace-nowrap">{s.from && <span class="text-xs font-body font-semibold uppercase tracking-wider text-muted-foreground mr-1">from</span>}{site.currency}{s.price}</p>
              <a href="#book" data-book-service={s.id} class="text-xs font-semibold uppercase tracking-[0.14em] text-rose-deep border-b border-rose-deep/40 pb-0.5 hover:border-rose-deep">Book</a>
            </div>
          </article>
        ))}
      </div>
    ))}
  </div>
</section>
<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('#services [role=tab]')];
  const select = (t: HTMLButtonElement, focus = false) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.classList.toggle('hidden', !on);
    });
    if (focus) t.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { e.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length], true); }
    });
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-book-service]').forEach((a) =>
    a.addEventListener('click', () => document.dispatchEvent(new CustomEvent('book:preset', { detail: { service: a.dataset.bookService } }))),
  );
</script>
