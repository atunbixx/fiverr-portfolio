---
const words = ['Precision Cuts', 'Lived-in Colour', 'Balayage', 'Silk Press', 'Knotless Braids', 'Curly Cuts', 'Bridal Styling', 'Bond Repair'];
const row = [...words, ...words];
---
<div class="border-y border-border bg-sand/60 overflow-hidden py-5" aria-hidden="true">
  <div class="flex w-max animate-marquee hover:[animation-play-state:paused]">
    {row.map((w) => (
      <span class="flex items-center gap-8 pr-8 display italic text-2xl sm:text-3xl text-foreground/85 whitespace-nowrap">{w}<span class="text-rose-deep not-italic text-base">✦</span></span>
    ))}
  </div>
</div>
