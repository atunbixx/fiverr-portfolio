---
import Icon from './Icon.astro';
import { site, hoursDisplay } from '../data/site';
const addr = `${site.address.street}, ${site.address.locality}, ${site.address.region} ${site.address.postcode}`;
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.name}, ${addr}`)}`;
---
<section id="visit" class="px-5 sm:px-8 lg:px-16 py-20 lg:py-28 border-t border-border">
  <div class="grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-5 reveal">
      <p class="eyebrow mb-4">Visit</p>
      <h2 class="h2 mb-8">Find us in <em class="italic text-rose-deep">East Austin</em></h2>
      <ul class="flex flex-col gap-5 mb-8">
        <li class="flex gap-4"><span class="w-10 h-10 rounded-full bg-rose-soft text-rose-deep grid place-items-center shrink-0"><Icon name="map-pin" size={17} /></span>
          <span><span class="block font-semibold">{site.address.street}</span><span class="block text-sm text-muted-foreground">{site.address.locality}, {site.address.region} {site.address.postcode} · free parking behind the studio</span></span></li>
        <li class="flex gap-4"><span class="w-10 h-10 rounded-full bg-rose-soft text-rose-deep grid place-items-center shrink-0"><Icon name="phone" size={17} /></span>
          <a href={`tel:${site.phone.replace(/[^0-9+]/g, '')}`} class="self-center font-semibold hover:text-rose-deep">{site.phone}</a></li>
        <li class="flex gap-4"><span class="w-10 h-10 rounded-full bg-rose-soft text-rose-deep grid place-items-center shrink-0"><Icon name="mail" size={17} /></span>
          <a href={`mailto:${site.email}`} class="self-center font-semibold hover:text-rose-deep">{site.email}</a></li>
      </ul>
      <a href={maps} target="_blank" rel="noopener" class="btn-ghost">Get directions <Icon name="arrow-up-right" size={15} /></a>
    </div>
    <div class="lg:col-span-6 lg:col-start-7 reveal">
      <div class="rounded-lg border border-border bg-surface p-8">
        <p class="flex items-center gap-2 font-semibold mb-6"><Icon name="clock" size={17} /> Opening hours</p>
        <dl>
          {hoursDisplay.map((h) => (
            <div class:list={['flex justify-between gap-4 py-3.5 border-b border-border last:border-0', { 'text-muted-foreground': h.time === 'Closed' }]} data-day={h.day}>
              <dt>{h.day}</dt><dd class="font-semibold">{h.time}</dd>
            </div>
          ))}
        </dl>
        <p class="text-xs text-muted-foreground mt-5">Late appointments on Thursdays · last colour booking 2 hours before close.</p>
      </div>
    </div>
  </div>
</section>
