---
interface Props { light?: boolean; size?: 'md' | 'lg' }
const { light = false, size = 'md' } = Astro.props;
---
<a href="#top" class={`display leading-none whitespace-nowrap ${size === 'lg' ? 'text-4xl' : 'text-[26px]'} ${light ? 'text-on-ink' : 'text-foreground'}`} aria-label="Sable & Rose — home">
  Sable <em class="italic text-rose-deep font-normal">&amp;</em> Rose
</a>
