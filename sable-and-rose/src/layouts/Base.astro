---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { site, hero, hours, menu } from '../data/site';
interface Props { title?: string; description?: string }
const { title = `${site.name} — ${site.tagline} in ${site.city}`, description = site.description } = Astro.props;
const og = await getImage({ src: hero.inset, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(og.src, Astro.site);
const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: site.name,
  description: site.description,
  url: canonical.href,
  image: ogUrl.href,
  telephone: site.phone,
  email: site.email,
  priceRange: '$$',
  address: { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: site.address.locality, addressRegion: site.address.region, postalCode: site.address.postcode, addressCountry: site.address.country },
  openingHoursSpecification: Object.entries(hours).filter(([, h]) => h).map(([d, h]) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: dayNames[Number(d)], opens: h!.open, closes: h!.close })),
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Hair services', itemListElement: menu.flatMap((c) => c.services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name }, price: s.price, priceCurrency: 'USD' }))) },
  sameAs: Object.values(site.social),
};
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f8f4ee" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn-ink">Skip to content</a>
    <slot />
    <script>
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
