---
import Base from '../layouts/Base.astro';
import NavBar from '../components/NavBar.astro';
import Hero from '../components/Hero.astro';
import QuoteCalculator from '../components/QuoteCalculator.astro';
import Services from '../components/Services.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import HowItWorks from '../components/HowItWorks.astro';
import TrustBar from '../components/TrustBar.astro';
import Reviews from '../components/Reviews.astro';
import Areas from '../components/Areas.astro';
import Faq from '../components/Faq.astro';
import BookingForm from '../components/BookingForm.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<Base>
  <NavBar />
  <main id="main">
    <Hero />
    <section id="quote" class="px-5 sm:px-8 lg:px-16 py-16 lg:py-20 bg-primary/5 border-y border-border">
      <div class="text-center mb-10 reveal">
        <h2 class="section-title">Get Your Instant Quote</h2>
        <p class="section-lead">No surprises — see your price upfront before you book.</p>
      </div>
      <QuoteCalculator />
    </section>
    <Services />
    <BeforeAfter />
    <HowItWorks />
    <TrustBar />
    <Reviews />
    <Areas />
    <Faq />
    <BookingForm />
  </main>
  <SiteFooter />
</Base>
