---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { nav } from '../data/site';
---
<header class="sticky top-0 z-40 bg-background/95 backdrop-blur border-b border-border">
  <nav class="flex items-center justify-between px-5 sm:px-8 lg:px-16 py-3.5 lg:py-4" aria-label="Main">
    <Logo />
    <ul class="hidden lg:flex items-center gap-8">
      {nav.map((l) => <li><a href={l.href} class="text-sm font-body text-muted-foreground font-medium hover:text-primary transition-colors">{l.label}</a></li>)}
    </ul>
    <div class="flex items-center gap-2">
      <a href="#quote" class="btn-primary whitespace-nowrap px-4 sm:px-5 py-2.5 text-sm">Book Now</a>
      <button id="nav-toggle" type="button" class="lg:hidden p-2 -mr-2 text-foreground" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <span class="icon-open"><Icon name="menu" size={22} /></span>
        <span class="icon-close hidden"><Icon name="x" size={22} /></span>
      </button>
    </div>
  </nav>
  <div id="mobile-nav" class="lg:hidden hidden border-t border-border bg-background">
    <ul class="flex flex-col px-5 sm:px-8 py-2">
      {nav.map((l) => <li><a href={l.href} class="block py-3 font-headings font-bold text-lg text-foreground border-b border-border last:border-0">{l.label}</a></li>)}
    </ul>
  </div>
</header>
<script>
  const btn = document.getElementById('nav-toggle')!;
  const panel = document.getElementById('mobile-nav')!;
  const set = (open: boolean) => {
    panel.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    btn.querySelector('.icon-open')!.classList.toggle('hidden', open);
    btn.querySelector('.icon-close')!.classList.toggle('hidden', !open);
  };
  btn.addEventListener('click', () => set(panel.classList.contains('hidden')));
  panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
</script>
