---
import Icon from './Icon.astro';
import { services } from '../data/site';
---
<section id="services" class="px-5 sm:px-8 lg:px-16 py-16 lg:py-20">
  <div class="text-center mb-12 reveal">
    <h2 class="section-title">Our Services</h2>
    <p class="section-lead max-w-xl mx-auto">From a quick weekly refresh to a full end-of-tenancy deep clean — we've got you covered.</p>
  </div>
  <div class="grid gap-5 lg:gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {services.map((s, i) => (
      <article class="reveal group bg-surface border border-border rounded-md p-6 flex flex-col gap-3 transition-all hover:-translate-y-1 hover:shadow-[0_12px_30px_-18px_rgba(13,122,122,.5)] hover:border-primary/30" style={`transition-delay:${(i % 3) * 70}ms`}>
        <span class="w-11 h-11 rounded-lg bg-secondary text-secondary-foreground grid place-items-center"><Icon name={s.icon} size={22} /></span>
        <h3 class="font-headings font-extrabold text-lg text-foreground">{s.title}</h3>
        <p class="text-sm text-muted-foreground font-body leading-relaxed">{s.description}</p>
        <a href="#quote" class="text-sm font-medium text-primary font-body mt-auto inline-flex items-center gap-1">Get a price <Icon name="arrow-right" size={14} class="transition-transform group-hover:translate-x-0.5" /></a>
      </article>
    ))}
  </div>
</section>
